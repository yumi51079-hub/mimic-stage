{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mimic-stage-online",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/rooms", "/api/rooms/*", "/health"]},
  "d1_databases": [{"binding": "DB", "database_name": "mimic-stage-rooms"}],
  "rules": [{"type": "Text", "globs": ["**/*.sql"], "fallthrough": true}],
  "build": {"command": "node cloudflare/build.mjs"}
}
